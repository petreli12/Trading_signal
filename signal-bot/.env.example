# X data provider (twitterapi.io via REST, X-API-Key header — NOT the official X API)
X_PROVIDER_API_KEY=
X_LIST_ID=

# LLM (Anthropic — sentiment + summarization)
ANTHROPIC_API_KEY=
LLM_MODEL=

# Ingestion inbox (reads the forwarded EOD PDF via IMAP)
IMAP_HOST=imap.gmail.com
IMAP_USER=
IMAP_PASSWORD=          # app-specific password, not your account password

# Delivery (sends the brief via SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=          # app-specific password
EMAIL_TO=

# Failure alerting (optional)
ALERT_ON_FAILURE=true   # set to false to disable the hard-failure alert email
ALERT_EMAIL_TO=         # defaults to EMAIL_TO if unset

# SMS digest (optional) — a short text via the carrier email-to-SMS gateway.
# Either set SMS_PHONE + SMS_CARRIER, or set SMS_TO directly to the gateway
# address. Leave all blank to disable SMS. Reuses the SMTP credentials above.
# Carriers: verizon, att, tmobile, googlefi, uscellular, cricket, boost,
#           metropcs, virgin, xfinity
SMS_PHONE=              # 10-digit US number, digits only (e.g. 5551234567)
SMS_CARRIER=            # one of the carriers listed above
SMS_TO=                 # OR a full gateway address (overrides SMS_PHONE/CARRIER)
