# X data provider (twitterapi.io via REST, X-API-Key header — NOT the official X API)
X_PROVIDER_API_KEY=
X_LIST_ID=

# LLM (Anthropic — sentiment + summarization)
ANTHROPIC_API_KEY=
LLM_MODEL=

# Ingestion inbox (reads the forwarded EOD PDF via IMAP)
IMAP_HOST=imap.gmail.com
IMAP_USER=
IMAP_PASSWORD=          # app-specific password, not your account password

# Delivery (sends the brief via SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=          # app-specific password
EMAIL_TO=

# Failure alerting (optional)
ALERT_ON_FAILURE=true   # set to false to disable the hard-failure alert email
ALERT_EMAIL_TO=         # defaults to EMAIL_TO if unset

# SMS digest — DISABLED. Carrier email-to-SMS gateways (e.g. Metro/T-Mobile)
# silently drop these messages, so SMS is turned off and email is the only
# channel. Leaving these blank keeps it disabled. To bring back real texts, use
# a proper SMS provider (e.g. Twilio) rather than the free gateways.
SMS_PHONE=
SMS_CARRIER=
SMS_TO=
